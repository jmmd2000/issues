# The dev database from docker compose (see docker-compose.override.yml).
DATABASE_URL="postgresql://issues:issues@localhost:5436/issues"
# The tests wipe this database before each run, so its name must end in _test.
# It is created and migrated on the first run.
DATABASE_URL_TEST="postgresql://issues:issues@localhost:5436/issues_test"
PORT=4000
# The web app's address, allowed by CORS.
WEB_ORIGIN="http://localhost:5173"
UPLOADS_DIR="./data/uploads"

# Optional caps (defaults shown). Bump if you need bigger uploads or have a larger VPS.
# MAX_IMAGE_BYTES=10000000
# MAX_FILE_BYTES=10000000
# MAX_IMAGE_OUTPUT_BYTES=1000000
# MAX_UPLOADS_BYTES=20000000000
