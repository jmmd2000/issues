{
  "name": "@issues/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "check": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/scripts/seed.ts",
    "db:sweep": "tsx src/scripts/sweep-uploads.ts",
    "test:unit": "vitest run --project unit",
    "test:integration": "NODE_ENV=test vitest run --project integration"
  },
  "dependencies": {
    "@hono/node-server": "1.19.12",
    "@hono/zod-validator": "0.9.1",
    "@issues/shared": "workspace:*",
    "argon2": "0.45.1",
    "dotenv": "17.4.1",
    "drizzle-orm": "0.45.3",
    "fractional-indexing": "3.2.0",
    "hono": "4.13.12",
    "pg": "8.23.1",
    "sharp": "0.35.5",
    "tsx": "4.23.15",
    "vitest": "5.0.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "typescript": "6.0.3"
  }
}
