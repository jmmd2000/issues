# Read by docker-compose.yml for the production stack.
APP_NAME="issues-production"
DOMAIN="issues.example.com"
GITHUB_USER=""
# The image tag to run. The deploy sets this to the short commit SHA.
IMAGE_TAG=""
POSTGRES_DB="issues"
POSTGRES_USER="issues"
POSTGRES_PASSWORD=""

# Error reporting to GlitchTip. Leave the DSNs blank to turn it off.
# The environment is needed when a DSN is set. The release is the image tag.
GLITCHTIP_API_DSN=""
GLITCHTIP_WEB_DSN=""
GLITCHTIP_ENVIRONMENT=""
