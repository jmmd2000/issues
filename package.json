{
  "name": "issues",
  "version": "1.4.0",
  "type": "module",
  "description": "",
  "scripts": {
    "prepare": "husky",
    "dev": "pnpm --parallel --filter @issues/api --filter web dev",
    "build": "pnpm -r build",
    "check": "pnpm -r check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm test:unit && pnpm test:integration",
    "test:unit": "pnpm -r --if-present test:unit",
    "test:integration": "pnpm -r --if-present test:integration",
    "test:e2e": "pnpm -r --if-present test:e2e",
    "db:generate": "pnpm --filter @issues/api db:generate",
    "db:migrate": "pnpm --filter @issues/api db:migrate",
    "db:seed": "pnpm --filter @issues/api db:seed"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@11.14.0",
  "engines": {
    "node": "22.x"
  },
  "devDependencies": {
    "@eslint/compat": "2.1.1",
    "@eslint/js": "10.0.1",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-svelte": "3.23.0",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.9",
    "prettier-plugin-svelte": "4.1.1",
    "typescript-eslint": "8.71.0"
  }
}
