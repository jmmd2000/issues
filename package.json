{
  "name": "issues",
  "version": "1.22.0",
  "type": "module",
  "description": "",
  "scripts": {
    "prepare": "husky",
    "dev": "pnpm --parallel --filter @issues/api --filter web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write . && eslint --fix .",
    "format:check": "prettier --check . && eslint .",
    "test": "pnpm test:unit && pnpm test:integration",
    "test:unit": "vitest run --project api-unit --project mcp-unit --project web-server --project web-client",
    "test:integration": "NODE_ENV=test vitest run --project api-integration",
    "coverage": "NODE_ENV=test vitest run --coverage",
    "test:e2e": "pnpm -r --if-present test:e2e",
    "db:generate": "pnpm --filter @issues/api db:generate",
    "db:migrate": "pnpm --filter @issues/api db:migrate",
    "db:seed": "pnpm --filter @issues/api db:seed"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@11.14.0",
  "engines": {
    "node": "26.x"
  },
  "devDependencies": {
    "@eslint/compat": "2.1.1",
    "@eslint/js": "10.0.1",
    "@sentry/cli": "3.8.0",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-svelte": "3.23.0",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.9",
    "prettier-plugin-svelte": "4.1.1",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  }
}
